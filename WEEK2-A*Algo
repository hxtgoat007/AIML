def aStarAlgo(start_node, stop_node, Graph_nodes, H_dist):
    open_set={start_node}
    close_set=set()
    g={start_node:0}
    parent={start_node:start_node}
    while open_set:
        n=min(open_set, key=lambda v:g[v]+H_dist.get(v,0))
        #Goal reached
        if n==stop_node:
            path=[]
            while parent[n]!=n:
                path.append(n)
                n=parent[n]
            path.append(start_node)
            path.reverse()
            cost=g[stop_node]
            print("Path found: ", path)
            print("Total Cost: ", cost)
            return path, cost
        for(m, weight) in Graph_nodes.get(n,[]):
            if m not in open_set and m not in close_set:
                open_set.add(m)
                parent[m]=n
                g[m]=g[n]+weight
            else:
                if g.get(m, float('inf'))>g[n]+weight:
                    g[m]=g[n]+weight
                    parent[m]=n
                    if m in close_set:
                        close_set.remove(m)
                        open_set.add(m)
        open_set.remove(n)
        close_set.add(n)
    print("Path not found")
    return  None, float('inf')

